        type            calculated;
        value           uniform 0;
    }

    "ground"
    {
        type            nutkWallFunction;
        value           uniform 0;
    }

    "ceiling"
    {
        type            nutkWallFunction;
        value           uniform 0;
    }

    "leftWall"
    {
        type            nutkWallFunction;
        value           uniform 0;
    }

    "rightWall"
    {
        type            nutkWallFunction;
        value           uniform 0;
    }

    "buildings"
    {
        type            nutkWallFunction;
        value           uniform 0;
    }

}

