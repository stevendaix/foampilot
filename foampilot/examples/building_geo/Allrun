#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
cd "$ROOT"
export PYTHONPATH="${ROOT}/foampilot/src${PYTHONPATH:+:${PYTHONPATH}}"

python3 foampilot/examples/building_geo/plot_urbgen_realistic_district.py
python3 foampilot/examples/building_geo/urbgen_population_report.py
python3 foampilot/examples/building_geo/validate_urbgen_cfd_chain.py

echo "UrbGEN geometry/mesh/export validation completed."
echo "This runner does not execute an OpenFOAM solver; see README.md for the scope."
