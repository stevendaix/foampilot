FoamFile
{
    format ascii;
    class volScalarField;
    location "0";
    object nut;
}
dimensions [0 2 -1 0 0 0 0];
internalField uniform 0;
boundaryField
{
    inlet { type fixedValue; value uniform 0; }
    outlet { type inletOutlet; inletValue uniform 0; value uniform 0; }
    sideA { type symmetryPlane; }
    sideB { type symmetryPlane; }
    bottom { type slip; }
    atmosphere { type inletOutlet; inletValue uniform 0; value uniform 0; }
    hull { type nutkWallFunction; value uniform 0; }
}
