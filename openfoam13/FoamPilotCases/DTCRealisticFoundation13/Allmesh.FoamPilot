#!/bin/sh
set -eu
cd "${0%/*}" || exit 1
: "${WM_PROJECT_DIR:?source OpenFOAM Foundation 13 first}"
. "$WM_PROJECT_DIR/bin/tools/RunFunctions"

# The scaled DTC STL is versioned with this case; no external tutorial path is needed.
test -f constant/geometry/DTC-scaled.stl.gz
runApplication surfaceFeatures
runApplication blockMesh
runApplication refineMesh
runApplication snappyHexMesh -overwrite
runApplication renumberMesh -noFields
runApplication checkMesh

#------------------------------------------------------------------------------
