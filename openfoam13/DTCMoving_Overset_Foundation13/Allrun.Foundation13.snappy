#!/usr/bin/env bash
ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
set +u
# shellcheck disable=SC1091
source "${FOAMPILOT_MARINE_ENV:-$ROOT/../marine_env.sh}"
set -euo pipefail
BACKGROUND="$ROOT/background"
HULL="$ROOT/hull"

# Foundation 13 mesh pipeline: create hull wall patch before coupling.
(cd "$HULL" && rm -rf constant/polyMesh && mkdir -p constant/geometry && cp -f hull.stl constant/geometry/hull.stl && blockMesh && surfaceFeatures && snappyHexMesh -overwrite && checkMesh -constant)
(cd "$BACKGROUND" && rm -rf constant/polyMesh && blockMesh && checkMesh -constant)

extract_centres()
{
    local CASE_PATH="$1"
    local TIME_SPEC="$2"
    local DYNAMIC="$CASE_PATH/constant/dynamicMeshDict"
    local DISABLED="$DYNAMIC.disabled"
    if [ -f "$DYNAMIC" ]; then mv "$DYNAMIC" "$DISABLED"; fi
    trap 'if [ -f "$DISABLED" ]; then mv "$DISABLED" "$DYNAMIC"; fi' RETURN
    (cd "$CASE_PATH" && foamPostProcess -func writeCellCentres -time "$TIME_SPEC")
    if [ -f "$DISABLED" ]; then mv "$DISABLED" "$DYNAMIC"; fi
    trap - RETURN
}
extract_centres "$BACKGROUND" 0
extract_centres "$HULL" constant
python3 "$ROOT/../build_dtc_intermesh_stencils.py"
python3 "$ROOT/../export_dtc_intermesh_dictionary.py"
cp "$BACKGROUND/constant/marineInterMeshStencils" "$HULL/constant/marineInterMeshStencils"
(cd "$HULL" && marineInterMeshStencilTest)
python3 "$ROOT/prepare_donor_region.py"
(cd "$BACKGROUND" && marineFoam -solver incompressibleVoF -donor-region hull)
