FoamFile
{
    format      ascii;
    class       volSymmTensorField;
    object      R;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform (0 0 0 0 0 0);

boundaryField
{
    left
    {
        type            cyclic;
    }

    right
    {
        type            cyclic;
    }

    walls
    {
        type            zeroGradient;
    }

    centreline
    {
        type            symmetryPlane;
    }

    frontAndBack
    {
        type            empty;
    }
}

