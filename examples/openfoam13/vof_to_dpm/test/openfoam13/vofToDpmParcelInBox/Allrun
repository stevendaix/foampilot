#!/bin/sh
set -e

caseDir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -n "${WM_PROJECT_DIR:-}" ]; then
    . "$WM_PROJECT_DIR/etc/bashrc" || true
elif [ -f /opt/openfoam13/etc/bashrc ]; then
    . /opt/openfoam13/etc/bashrc || true
else
    echo "OpenFOAM 13 environment not found" >&2
    exit 1
fi
set -u

runDir="$caseDir/run"
rm -rf "$runDir"
base="$FOAM_TUTORIALS/multicomponentFluid/parcelInBox"
if [ ! -d "$base" ]; then
    echo "OpenFOAM parcelInBox tutorial not found: $base" >&2
    exit 1
fi
cp -a "$base" "$runDir"
cp "$caseDir/0/alpha.liquid" "$runDir/0/alpha.liquid"
sed -i 's/endTime         0.5;/endTime         0.005;/' "$runDir/system/controlDict"

cd "$runDir"
blockMesh > log.blockMesh
vofToDpm -alpha alpha.liquid -U U -threshold 0.5 -rhoLiquid 1000 > log.vofToDpm

mass=$(awk '/mass [0-9.eE+-]+;/{for (i=1;i<=NF;i++) if ($i=="mass") {gsub(";", "", $(i+1)); print $(i+1); exit}}' constant/vofToDpmFragments)
diameter=$(awk '/diameter [0-9.eE+-]+;/{for (i=1;i<=NF;i++) if ($i=="diameter") {gsub(";", "", $(i+1)); print $(i+1); exit}}' constant/vofToDpmFragments)
[ -n "$mass" ]
[ -n "$diameter" ]
sed -i "s/massTotal[[:space:]].*/massTotal       $mass; \/\/ generated by vofToDpm/" constant/cloudProperties
sed -i "s/value           100e-06;/value           $diameter; \/\/ generated by vofToDpm/" constant/cloudProperties

foamRun -solver multicomponentFluid > log.foamRun 2>&1
grep -q 'Added 1 new parcels' log.foamRun
grep -q "mass introduced             = $mass" log.foamRun
grep -q '^End$' log.foamRun

echo "PASS: VOF-derived cloudPositions injected into OpenFOAM 13 parcelInBox"
