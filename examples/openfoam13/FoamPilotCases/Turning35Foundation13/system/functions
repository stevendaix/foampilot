FoamFile
{
    format ascii;
    class dictionary;
    location "system";
    object functions;
}
forces
{
    type forces;
    libs ("libforces.so");
    patches (hull);
    CofR (0 0 0);
    writeControl timeStep;
    writeInterval 1;
}
