FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 24;

boundaryField
{
   
    inlet	
    {
        type            turbulentIntensityKineticEnergyInlet;
        intensity       0.05;     								  // % turbulent intensity
        value           $internalField;
    }
    
    atmosphere	
    {
        type            zeroGradient;
    }
    
    wall 
    {
        type            compressible::kqRWallFunction;
        value           $internalField;
    } 
}


