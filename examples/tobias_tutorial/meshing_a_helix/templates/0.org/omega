FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 1900;

boundaryField
{
    inlet	
    {
        type            compressible::turbulentMixingLengthFrequencyInlet;
        mixingLength    0.00252;
        value           $internalField; 
    }
    
	atmosphere
    {
        type            zeroGradient;
    }
    
    wall 
    {
        type            compressible::omegaWallFunction;
        value           $internalField;
    }
}


