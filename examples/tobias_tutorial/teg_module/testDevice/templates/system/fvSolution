FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    T
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-10;
        relTol          0.1;
        minIter         1;
    }

    TFinal
    {
        $T;
        relTol          0;
    }
}

PIMPLE
{
    nNonOrthogonalCorrectors 1;
}


