FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     simpleFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         2000;

deltaT          1;

writeControl    timeStep;

writeInterval   2000;

purgeWrite      0;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

libs
(
    "libfieldFunctionObjects.so"
    "libsolverFunctionObjects.so"
);

//- Passive scalar that imitates the mixture (Temperature)
functions
{
    T
    {
        type            scalarTransport;
        writeInterval   outputTime;
        field           T;
        schemesField    T;
        nCorr           0;
        resetOnStartUp  false;
    }

    //- Flux weighted average at outlet surface
    Taverage
    {
        type            surfaceRegion;
        writeControl    writeTime;
        log             no;
        writeFields     no;
        regionType      patch;
        name            outlet;
        operation       weightedAverage;
        weightField     phi;

        fields          
        (
            T
        );
    }
}

