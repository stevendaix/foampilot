FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    AMI
    {
        type            zeroGradient;
    }

    AMI_slave
    {
        type            zeroGradient;
    }

    inlet 
    {
        type            totalPressure;
        p0              uniform 16;
        value           uniform 0;
    }

    outlet 
    {
        type            fixedValue;
        value           uniform 0;
    }

    wall 
    {
        type            zeroGradient;
        value           uniform 0;
    }
}

