FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      changeDictionaryDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

T
{
    //- ICE CUBES have -13 degree
    internalField   uniform 260;

    boundaryField
    {
        isolated 
        {
            type    zeroGradient;
        }

        iceCube2_to_ginTonic
        {
            type    compressible::turbulentTemperatureCoupledBaffleMixed;
            value   $internalField;
            kappaMethod solidThermo; 
            Tnbr    T;
        }
    }
}

p
{
    boundaryField
    {
        isolated 
        {
            type    calculated;
            value   $internalField;
        }

        iceCube2_to_ginTonic
        {
            type    calculated;
            value   $internalField;
        }
    }
}
