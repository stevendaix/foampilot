FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      changeDictionaryDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

boundary
{
    air_to_street
    {
        type            mappedWall;
        neighbourRegion street;
        neighbourPatch  street_to_air;
        offsetMode      uniform;
        offset          (0 0 0);
    }
    air_to_windward
    {
        type            mappedWall;
        neighbourRegion windward;
        neighbourPatch  windward_to_air;
        offsetMode      uniform;
        offset          (0 0 0);
    }
    air_to_leeward
    {
        type            mappedWall;
        neighbourRegion leeward;
        neighbourPatch  leeward_to_air;
        offsetMode      uniform;
        offset          (0 0 0);
    }
}

