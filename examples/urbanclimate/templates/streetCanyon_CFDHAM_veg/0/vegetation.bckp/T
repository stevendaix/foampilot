FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/vegetation";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 285;

boundaryField
{
    inlet
    {
        type            mappedValue;
        value           uniform 285;
    }
    outlet
    {
        type            mappedValue;
        value           uniform 285;
    }
    top
    {
        type            mappedValue;
        value           uniform 285;
    }
    ground
    {
        type            mappedValue;
        value           uniform 285;
    }
    air_to_street
    {
        type            mappedValue;
        value           uniform 285;
    }
    air_to_windward
    {
        type            mappedValue;
        value           uniform 285;
    }
    air_to_leeward
    {
        type            mappedValue;
        value           uniform 285;
    }
    side1
    {
        type            mappedValue;
        value           uniform 285;
    }
    side2
    {
        type            mappedValue;
        value           uniform 285;
    }
    buildings
    {
        type            mappedValue;
        value           uniform 285;
    }
    air_to_vegetation
    {
        type            mappedLeafTemperature;
        field           Tl; 
        setAverage      0;  
        average         0;
        interpolationScheme cell;
        value           uniform 285;
    }
}


