FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      changeDictionaryDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

boundary
{
    west
    {
        type            mapped;
        neighbourRegion air;
        neighbourPatch  west;
        offsetMode      uniform;
        offset          (0 0 0);
    }
    east
    {
        type            mapped;
        neighbourRegion air;
        neighbourPatch  east;
        offsetMode      uniform;
        offset          (0 0 0);
    }
    north
    {
        type            mapped;
        neighbourRegion air;
        neighbourPatch  north;
        offsetMode      uniform;
        offset          (0 0 0);
    }
    south
    {
        type            mapped;
        neighbourRegion air;
        neighbourPatch  south;
        offsetMode      uniform;
        offset          (0 0 0);
    }
    ground
    {
        type            mappedWall;
        neighbourRegion air;
        neighbourPatch  ground;
        offsetMode      uniform;
        offset          (0 0 0);
        matchTolerance  0.01;
    }
    top
    {
        type            mapped;
        neighbourRegion air;
        neighbourPatch  top;
        offsetMode      uniform;
        offset          (0 0 0);
    }
    buildings
    {
        type            mappedWall;
        neighbourRegion air;
        neighbourPatch  buildings;
        offsetMode      uniform;
        offset          (0 0 0);
    }
    air_to_vegetation
    {
        type            mappedInternal;
        neighbourRegion air;
        offsetMode      normal;
        distance        0;
    }
}

