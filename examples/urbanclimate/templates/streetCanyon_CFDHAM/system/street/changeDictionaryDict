FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      changeDictionaryDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

boundary
{
    street_to_air
    {
        type            mappedWall;
        method          nearest;
        neighbourRegion air;
        neighbourPatch  air_to_street;
        offsetMode      uniform;
        offset          (0 0 0);
    }
}

